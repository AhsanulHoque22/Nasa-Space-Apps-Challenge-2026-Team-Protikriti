{
  // Type-checks the Vercel function in api/ (Vercel compiles it with this file). The app has its
  // own config in web/; Node types come from web's install, as the repo root installs nothing.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "typeRoots": ["./web/node_modules/@types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["api"]
}
